# ───────────────────────────────────────────────
# آرکان — متغیرهای محیطی
# این فایل را به .env.local کپی کنید و مقادیر را پر کنید.
# همین مقادیر را در Vercel هم بگذارید: Settings → Environment Variables
# (متغیر تازه فقط روی دیپلوی بعدی اثر دارد؛ بعد از افزودن، Redeploy بزنید).
# ───────────────────────────────────────────────

# ── ضروری ─────────────────────────────────────────────────────────

# Supabase — از داشبورد پروژه: Project Settings → API
# جدول‌ها در اسکیمای arkan هستند؛ supabase/00-arkan-schema.sql را اول اجرا کنید.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# پنل مدیریت (/admin)
# ADMIN_PASSWORD: رمز ورود اول و «کد راه‌اندازی» ساخت اولین حساب مالک.
# ADMIN_SESSION_SECRET: رشته‌ی تصادفی مستقل برای امضای کوکی نشست؛ با این دستور بسازید:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=یک-رمز-قوی-بگذارید
ADMIN_SESSION_SECRET=یک-رشته-تصادفی-بلند

# مدل‌های زبانی: همه از طریق OpenRouter (چت‌بات، قابلیت‌های AI در CRM، دستیار)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embedding چت‌بات (جدا از OpenRouter): Cohere چندزبانه
EMBEDDING_PROVIDER=cohere
EMBEDDING_MODEL=embed-multilingual-v3.0
COHERE_API_KEY=xxxxxxxxxxxx

# ── اختیاری ───────────────────────────────────────────────────────

# ایمیل با Resend — کمپین‌ها، ارسال پروپوزال و قرارداد با PDF پیوست.
# فرستنده باید روی دامنه‌ای باشد که در Resend تأیید شده؛ بدون دامنه‌ی تأییدشده،
# Resend فقط به ایمیل صاحب حساب می‌فرستد. بدون این کلید، همه‌چیز جز ارسال ایمیل کار می‌کند.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM=Arkan <arkan@send.example.com>
# CRM_NOTIFY_EMAIL=you@example.com   # اعلان پاسخ کلاینت + Reply-To ایمیل‌های کلاینت

# کانال تلگرام چت‌بات
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_WEBHOOK_SECRET=یک-رشته-تصادفی

# بلاگ (فاز ۳) — پروژه‌ی Supabase جداگانه‌ی arkan-blog-agents؛ فقط خواندنی.
# بدون آن، صفحه‌ی بلاگ خالی می‌ماند و «پیشنهاد محتوا» پستی پیدا نمی‌کند.
# BLOG_SUPABASE_URL=https://YOUR-BLOG-PROJECT.supabase.co
# BLOG_SUPABASE_SERVICE_ROLE_KEY=your-blog-service-role-key

# نکته: اگر به‌جای مقدار دستی از «vercel env pull» استفاده می‌کنید، مقدارها را نگاه کنید؛
# گاهی آخرشان یک «\n» نوشتاری می‌چسبد و ایمیل یا کلید را نامعتبر می‌کند.
