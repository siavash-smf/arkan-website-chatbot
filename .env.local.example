# ───────────────────────────────────────────────
# آرکان — متغیرهای محیطی
# این فایل را به .env.local کپی کنید و مقادیر را پر کنید.
# ───────────────────────────────────────────────

# Supabase (برای ذخیره‌ی درخواست‌های مشاوره در جدول leads)
# از داشبورد پروژه: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# پنل مدیریت (/admin) — برای دسترسی مدیر به درخواست‌ها
# ADMIN_PASSWORD: رمزی که مدیر با آن وارد /admin می‌شود (آن را تغییر دهید).
# ADMIN_SESSION_SECRET: یک رشته‌ی تصادفی برای امضای کوکی نشست؛ با این دستور بسازید:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=یک-رمز-قوی-بگذارید
ADMIN_SESSION_SECRET=یک-رشته-تصادفی-بلند

# ── چت‌بات RAG (فاز ۲) ──────────────────────────────────────────
# تولید پاسخ: همه‌ی مدل‌ها از طریق OpenRouter (یک کلید برای همه)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embedding (جداگانه از OpenRouter): پیش‌فرض Cohere چندزبانه
EMBEDDING_PROVIDER=cohere
EMBEDDING_MODEL=embed-multilingual-v3.0
COHERE_API_KEY=xxxxxxxxxxxx

# تلگرام (برای فاز بعد؛ در Milestone 1 استفاده نمی‌شود)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# ایمیل با Resend — کمپین‌ها، ارسال پروپوزال و قرارداد با PDF پیوست
# فرستنده باید روی دامنه‌ای باشد که در Resend تأیید شده؛ بدون دامنه‌ی تأییدشده،
# Resend فقط به ایمیل صاحب حساب می‌فرستد.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM=Arkan <arkan@send.example.com>
# CRM_NOTIFY_EMAIL=you@example.com   # اعلان پاسخ کلاینت + Reply-To ایمیل‌های کلاینت

# نکته: تا زمانی که کلیدهای Supabase تنظیم نشده باشند، فرم در حالت
# «فالبک» کار می‌کند و درخواست‌ها در کنسول سرور لاگ می‌شوند.
